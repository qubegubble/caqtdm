environment.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile environment.pro -spec linux-g++

qmake_all: FORCE


all: Makefile $(CAQTDM_COLLECT)/controlsystems/libenvironment_plugin.so

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents environment_plugin.h ../controlsinterface.h $(DISTDIR)/
	$(COPY_FILE) --parents environment_plugin.cpp $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(CAQTDM_COLLECT)/controlsystems/$(TARGET) 
	-$(DEL_FILE) Makefile


