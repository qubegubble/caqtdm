qmake: FORCE
	@$(QMAKE) -o Makefile epics4.pro -spec linux-g++

qmake_all: FORCE


all: Makefile $(CAQTDM_COLLECT)/controlsystems/libepics4_plugin.so

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents epics4_plugin.h ../controlsinterface.h epics4_callbackThread.h epics4Requester.h $(DISTDIR)/
	$(COPY_FILE) --parents epics4_plugin.cpp epics4_callbackThread.cpp epics4Requester.cpp $(DISTDIR)/


